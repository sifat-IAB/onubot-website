            "g_d1_f1"
          ]
        },
        {
          "text": "EPS or the disclosed payment provider, if enabled",
          "y": 98.67001096875038,
          "size": 10.994999391875005,
          "fonts": [
            "g_d1_f8"
          ]
        },
        {
          "text": "Payment-entry data handled by the gateway and transaction references used by Onubot.",
          "y": 78.42001181249998,
