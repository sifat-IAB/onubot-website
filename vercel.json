{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/deletion-request.mjs": { "maxDuration": 30 },
    "api/contact.mjs": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/:file.mjs",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
